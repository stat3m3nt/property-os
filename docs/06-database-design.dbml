Enum user_status {
  active
  inactive
  suspended
  pending_verification
}

Enum property_type {
  residential
  commercial
  mixed_use
}

Enum unit_status {
  vacant
  occupied
  under_maintenance
  reserved
  offline
}

Enum lease_status {
  draft
  pending_signature
  active
  pending_renewal
  renewed
  expired
  terminated
}

Enum invoice_status {
  draft
  issued
  paid
  partially_paid
  overdue
  void
}

Enum payment_status {
  pending
  completed
  failed
  refunded
  disputed
}

Enum payment_method_type {
  credit_card
  debit_card
  ach
  bank_transfer
  cash
  check
  stripe_wallet
}

Enum maintenance_status {
  open
  triaged
  assigned
  in_progress
  on_hold
  completed
  cancelled
}

Enum work_order_status {
  pending
  scheduled
  in_progress
  completed
  cancelled
}

Enum document_owner_type {
  organization
  property
  unit
  lease
  tenant
  vendor
  work_order
}

Enum notification_channel {
  email
  sms
  push
  in_app
}

Enum announcement_audience {
  all_tenants
  property_tenants
  building_tenants
  all_staff
}

Enum subscription_status {
  trialing
  active
  past_due
  canceled
  paused
}

Enum billing_interval {
  monthly
  annual
}

Enum job_status {
  queued
  processing
  completed
  failed
  retrying
  cancelled
}

Enum webhook_status {
  pending
  processed
  failed
  ignored
}

// =========================================================================
// DOMAIN: ORGANIZATION MANAGEMENT
// =========================================================================

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  slug varchar(100) [not null, unique]
  legal_name varchar(255)
  billing_email varchar(255) [not null]
  stripe_customer_id varchar(255)
  subscription_plan varchar(50) [not null, default: 'trial']
  is_active boolean [not null, default: true]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    slug [unique]
    is_active
  }
}

Table organization_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  setting_key varchar(150) [not null]
  setting_value text
  value_type varchar(20) [not null, default: 'string']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, setting_key) [unique]
  }
}

// =========================================================================
// DOMAIN: IDENTITY & ACCESS
// =========================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  supabase_auth_id uuid [not null, unique, note: 'Maps to Supabase Auth user']
  email varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30)
  status user_status [not null, default: 'pending_verification']
  last_login_at timestamptz
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, email) [unique]
    supabase_auth_id [unique]
  }
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [note: 'null = system-defined global role']
  name varchar(100) [not null]
  description varchar(500)
  is_system_role boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, name) [unique]
  }
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(150) [not null, unique, note: 'e.g. lease.create, invoice.void']
  description varchar(500)
  domain varchar(100) [not null, note: 'e.g. finance, maintenance, property']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique]
    domain
  }
}

Table role_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  role_id uuid [not null]
  organization_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (user_id, role_id) [unique]
  }
}

Table user_invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  email varchar(255) [not null]
  role_id uuid [not null]
  invited_by uuid [not null]
  token varchar(255) [not null, unique]
  status varchar(20) [not null, default: 'pending']
  expires_at timestamptz [not null]
  accepted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    token [unique]
    (organization_id, email)
  }
}

Table password_resets {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    token [unique]
    user_id
  }
}

// =========================================================================
// DOMAIN: PROPERTY PORTFOLIO
// =========================================================================

Table properties {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  property_type property_type [not null]
  landlord_user_id uuid [note: 'owning landlord, nullable if company-owned']
  year_built int
  is_active boolean [not null, default: true]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    organization_id
    (organization_id, is_active)
  }
}

Table property_addresses {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  property_id uuid [not null, unique]
  line1 varchar(255) [not null]
  line2 varchar(255)
  city varchar(100) [not null]
  state_province varchar(100) [not null]
  postal_code varchar(20) [not null]
  country varchar(100) [not null]
  latitude decimal(9,6)
  longitude decimal(9,6)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    property_id [unique]
    (city, state_province)
  }
}

Table property_images {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  property_id uuid [not null]
  storage_path varchar(500) [not null, note: 'Supabase Storage object key']
  caption varchar(255)
  is_primary boolean [not null, default: false]
  display_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    property_id
  }
}

Table buildings {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  property_id uuid [not null]
  name varchar(255) [not null]
  building_code varchar(50)
  total_floors int
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    property_id
  }
}

Table floors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  building_id uuid [not null]
  floor_number int [not null]
  label varchar(50)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (building_id, floor_number) [unique]
  }
}

Table units {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  property_id uuid [not null]
  building_id uuid
  floor_id uuid
  unit_number varchar(50) [not null]
  unit_type varchar(50) [note: 'studio, 1BR, office suite, retail, etc']
  square_feet decimal(10,2)
  bedrooms int
  bathrooms decimal(3,1)
  base_rent decimal(12,2) [not null]
  status unit_status [not null, default: 'vacant']
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (property_id, unit_number) [unique]
    status
    organization_id
  }
}

Table amenities {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(150) [not null]
  description varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, name) [unique]
  }
}

Table unit_amenities {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  unit_id uuid [not null]
  amenity_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (unit_id, amenity_id) [unique]
  }
}

// =========================================================================
// DOMAIN: TENANT MANAGEMENT
// =========================================================================

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  user_id uuid [note: 'nullable — tenant may not have portal login']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null]
  phone varchar(30)
  date_of_birth date
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, email)
    user_id
  }
}

Table tenant_emergency_contacts {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  tenant_id uuid [not null]
  full_name varchar(200) [not null]
  relationship varchar(100)
  phone varchar(30) [not null]
  email varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
  }
}

Table tenant_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  tenant_id uuid [not null]
  document_id uuid [not null]
  document_category varchar(100) [note: 'id_proof, income_verification, background_check']
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    tenant_id
    document_id
  }
}

Table occupancies {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  unit_id uuid [not null]
  tenant_id uuid [not null]
  lease_id uuid [not null]
  move_in_date date [not null]
  move_out_date date
  is_primary_occupant boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    unit_id
    tenant_id
    (unit_id, tenant_id, move_in_date) [unique]
  }

  Note: 'Overlapping tenancy on the same unit (two tenants both "occupying" the same unit in the same date range) cannot be expressed via a unique index alone — enforced via a PostgreSQL EXCLUDE constraint added in migration (see SQL notes / review doc).'
}

// =========================================================================
// DOMAIN: LEASE MANAGEMENT
// =========================================================================

Table leases {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  unit_id uuid [not null]
  lease_number varchar(50) [not null]
  start_date date [not null]
  end_date date [not null, note: 'BRULE-LEASE-002: must be > start_date — enforced via CHECK constraint added in migration, see SQL notes at bottom of file']
  monthly_rent decimal(12,2) [not null]
  status lease_status [not null, default: 'draft']
  signed_at timestamptz
  terminated_at timestamptz
  termination_reason varchar(500)
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, lease_number) [unique]
    unit_id [note: 'BRULE-UNIT-002: a unit cannot have 2+ ACTIVE leases at once — enforced via partial unique index added in migration (unit_id WHERE status = active), see SQL notes at bottom of file']
    status
  }
}

Table lease_tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  lease_id uuid [not null]
  tenant_id uuid [not null]
  is_primary_signer boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (lease_id, tenant_id) [unique]
  }
}

Table lease_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  lease_id uuid [not null]
  document_id uuid [not null]
  document_category varchar(100) [note: 'signed_lease, addendum, disclosure']
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    lease_id
  }
}

Table security_deposits {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  lease_id uuid [not null, unique]
  amount decimal(12,2) [not null]
  amount_returned decimal(12,2) [default: 0]
  held_at varchar(255) [note: 'escrow / trust account reference']
  status varchar(30) [not null, default: 'held']
  returned_at timestamptz
  deduction_notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    lease_id [unique]
  }
}

Table lease_renewals {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  original_lease_id uuid [not null]
  new_lease_id uuid [not null, unique]
  proposed_rent decimal(12,2) [not null]
  proposed_at timestamptz [not null, default: `now()`]
  accepted_at timestamptz
  status varchar(30) [not null, default: 'proposed']
  created_by uuid

  indexes {
    original_lease_id
    new_lease_id [unique]
  }
}

Table lease_amendments{
  id uuid [pk, default: `gen_random_uuid()`]
  lease_id uuid [not null]
  amendment_number varchar(50) [not null]
  organization_id uuid [not null]
  description text
  effective_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz


  indexes {
    (lease_id, amendment_number) [unique]
  }
}

// =========================================================================
// DOMAIN: FINANCE
// =========================================================================

Table rent_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  lease_id uuid [not null]
  frequency varchar(20) [not null, default: 'monthly']
  amount decimal(12,2) [not null]
  due_day_of_month int [not null, default: 1]
  start_date date [not null]
  end_date date
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    lease_id
  }
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  lease_id uuid [not null]
  invoice_number varchar(50) [not null]
  issue_date date [not null]
  due_date date [not null]
  subtotal decimal(12,2) [not null]
  tax_amount decimal(12,2) [not null, default: 0]
  total_amount decimal(12,2) [not null]
  amount_paid decimal(12,2) [not null, default: 0]
  status invoice_status [not null, default: 'draft']
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, invoice_number) [unique]
    lease_id
    status
    due_date
  }
}

Table invoice_line_items {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  invoice_id uuid [not null]
  description varchar(255) [not null]
  line_type varchar(50) [not null, note: 'rent, utility, late_fee, parking, other']
  quantity decimal(10,2) [not null, default: 1]
  unit_price decimal(12,2) [not null]
  amount decimal(12,2) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    invoice_id
  }
}

Table payment_methods {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  tenant_id uuid [not null]
  method_type payment_method_type [not null]
  stripe_payment_method_id varchar(255)
  last_four varchar(4)
  is_default boolean [not null, default: false]
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tenant_id
  }
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  invoice_id uuid [not null]
  payment_method_id uuid
  amount decimal(12,2) [not null]
  status payment_status [not null, default: 'pending']
  paid_at timestamptz
  stripe_payment_intent_id varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    invoice_id
    status
  }

  Note: 'BRULE-PAY-001: a payment must be associated with an ACTIVE lease (via invoice -> lease). This is state-dependent and cannot be enforced by a static FK/CHECK — enforce at the application/service layer or via a BEFORE INSERT trigger that validates lease.status = active.'
}

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  payment_id uuid
  transaction_type varchar(30) [not null, note: 'charge, refund, chargeback, adjustment']
  amount decimal(12,2) [not null]
  currency varchar(3) [not null, default: 'USD']
  stripe_event_id varchar(255) [unique]
  raw_payload jsonb
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    payment_id
    stripe_event_id [unique]
  }
}

Table late_fees {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  invoice_id uuid [not null]
  invoice_line_item_id uuid [note: 'nullable — set once this assessed fee has been billed as a line item, so the two records can never silently diverge']
  amount decimal(12,2) [not null]
  applied_date date [not null]
  reason varchar(255)
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    invoice_id
  }

  Note: 'Represents the ASSESSMENT of a late fee (when/why it was triggered, possibly by an automated job). invoice_line_items with line_type=late_fee represents the BILLED artifact. invoice_line_item_id links the two once billed — do not treat these as duplicate/redundant tables.'
}

// =========================================================================
// DOMAIN: MAINTENANCE
// =========================================================================

Table maintenance_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(150) [not null]
  description varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, name) [unique]
  }
}

Table maintenance_priorities {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(50) [not null, note: 'low, medium, high, emergency']
  sla_hours int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, name) [unique]
  }
}

Table maintenance_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  property_id uuid [not null, note: 'always set — enables common-area requests (roof, lobby, elevator, parking lot)']
  unit_id uuid [note: 'nullable — null for common-area / building-wide issues not tied to a specific unit']
  building_id uuid [note: 'nullable — set for building-level common-area issues']
  tenant_id uuid
  category_id uuid [not null]
  priority_id uuid [not null]
  title varchar(255) [not null]
  description text
  status maintenance_status [not null, default: 'open']
  reported_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    unit_id
    property_id
    status
    (organization_id, status)
  }

  Note: 'BRULE-MAINT-001: request must belong to a property or unit. property_id is always required; unit_id is only set for unit-specific issues. Enforce at the app layer that unit_id (when set) belongs to property_id.'
}

Table maintenance_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  maintenance_request_id uuid [not null]
  previous_status maintenance_status
  new_status maintenance_status [not null]
  changed_by uuid
  notes varchar(500)
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    maintenance_request_id
    (maintenance_request_id, changed_at)
  }

  Note: 'Satisfies BRULE-MAINT-002 (maintenance requests must maintain status history) and supports BRULE-MAINT-003 (only authorized users may update status) via changed_by + role/permission checks at write time.'
}

Table maintenance_images {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  maintenance_request_id uuid [not null]
  storage_path varchar(500) [not null]
  caption varchar(255)
  uploaded_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    maintenance_request_id
  }
}

Table vendors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  company_name varchar(255) [not null]
  contact_name varchar(200)
  email varchar(255)
  phone varchar(30)
  trade_specialty varchar(150) [note: 'plumbing, electrical, HVAC, general']
  is_active boolean [not null, default: true]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    organization_id
  }
}

Table work_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  maintenance_request_id uuid [not null]
  work_order_number varchar(50) [not null]
  status work_order_status [not null, default: 'pending']
  scheduled_date date
  completed_date date
  estimated_cost decimal(12,2)
  actual_cost decimal(12,2)
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (organization_id, work_order_number) [unique]
    maintenance_request_id
    status
  }
}

Table vendor_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  work_order_id uuid [not null]
  vendor_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  role_on_job varchar(100) [note: 'primary, subcontractor']
  created_by uuid

  indexes {
    (work_order_id, vendor_id) [unique]
  }
}

// =========================================================================
// DOMAIN: DOCUMENTS
// =========================================================================

Table folders {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  parent_folder_id uuid [note: 'self-reference for nested folders']
  name varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    organization_id
    parent_folder_id
  }
}

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  folder_id uuid
  owner_type document_owner_type [not null]
  owner_id uuid [not null, note: 'polymorphic reference, enforced at app layer']
  file_name varchar(255) [not null]
  storage_path varchar(500) [not null, note: 'Supabase Storage object key']
  mime_type varchar(150)
  file_size_bytes bigint
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    (owner_type, owner_id)
    folder_id
    organization_id
  }

  Note: 'BR-DOC-003 (restrict document access based on permissions) is covered at the RBAC level via permission codes (e.g. document.view, document.delete) scoped by domain/owner_type. If per-document ACLs beyond role-based access are needed later, add a document_permissions join table — not required for v1 scope.'
}

Table attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  document_id uuid [not null]
  related_entity_type varchar(50) [not null, note: 'message, announcement, maintenance_request']
  related_entity_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    document_id
    (related_entity_type, related_entity_id)
  }
}

// =========================================================================
// DOMAIN: COMMUNICATION
// =========================================================================

Table notification_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [note: 'null = global system template']
  code varchar(150) [not null]
  channel notification_channel [not null]
  subject varchar(255)
  body_template text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, code, channel) [unique]
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  user_id uuid
  tenant_id uuid
  template_id uuid
  channel notification_channel [not null]
  subject varchar(255)
  body text [not null]
  is_read boolean [not null, default: false]
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    tenant_id
    (organization_id, is_read)
  }
}

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  sender_user_id uuid
  sender_tenant_id uuid
  recipient_user_id uuid
  recipient_tenant_id uuid
  subject varchar(255)
  body text [not null]
  is_read boolean [not null, default: false]
  sent_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    sender_user_id
    recipient_user_id
    recipient_tenant_id
  }
}

Table announcements {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  property_id uuid [note: 'nullable — org-wide if null']
  title varchar(255) [not null]
  body text [not null]
  audience announcement_audience [not null, default: 'all_tenants']
  published_at timestamptz
  expires_at timestamptz
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid

  indexes {
    organization_id
    property_id
  }
}

// =========================================================================
// DOMAIN: ADMINISTRATION
// =========================================================================

Table system_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  setting_key varchar(150) [not null, unique]
  setting_value text
  value_type varchar(20) [not null, default: 'string']
  is_editable boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid

  indexes {
    setting_key [unique]
  }
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid
  actor_user_id uuid
  entity_type varchar(100) [not null]
  entity_id uuid [not null]
  action varchar(50) [not null, note: 'create, update, delete, restore']
  before_state jsonb
  after_state jsonb
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
    organization_id
    actor_user_id
  }
}

Table activity_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  actor_user_id uuid
  actor_tenant_id uuid
  activity_type varchar(100) [not null, note: 'login, invoice_viewed, request_submitted']
  metadata jsonb
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id
    actor_user_id
    activity_type
  }
}

// =========================================================================
// DOMAIN: SAAS PLATFORM & BILLING
// (This is PropertyOS billing the ORGANIZATION for using the platform —
//  distinct from the tenant-facing `invoices`/`payments` tables above,
//  which are rent billing between the organization and ITS tenants.)
// =========================================================================

Table billing_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [not null, unique, note: 'starter, professional, enterprise']
  name varchar(100) [not null]
  billing_interval billing_interval [not null]
  price_amount decimal(12,2) [not null]
  currency varchar(3) [not null, default: 'USD']
  max_units int [note: 'plan limit — null = unlimited']
  max_users int [note: 'plan limit — null = unlimited']
  features jsonb [note: 'feature entitlements for this plan']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique]
  }
}

Table organization_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  plan_id uuid [not null]
  status subscription_status [not null, default: 'trialing']
  stripe_subscription_id varchar(255)
  current_period_start timestamptz
  current_period_end timestamptz
  cancel_at_period_end boolean [not null, default: false]
  trial_ends_at timestamptz
  canceled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id [note: 'BRULE-style constraint: only one ACTIVE subscription per org — enforced via partial unique index added in migration']
    stripe_subscription_id
  }
}

Table platform_invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  organization_subscription_id uuid
  stripe_invoice_id varchar(255) [unique]
  amount_due decimal(12,2) [not null]
  amount_paid decimal(12,2) [not null, default: 0]
  currency varchar(3) [not null, default: 'USD']
  status varchar(30) [not null, default: 'open', note: 'open, paid, void, uncollectible']
  issued_at timestamptz
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id
    stripe_invoice_id [unique]
  }
}

// =========================================================================
// DOMAIN: SECURITY & ACCESS
// =========================================================================

Table api_keys {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(150) [not null]
  key_prefix varchar(20) [not null, note: 'shown to user for identification, e.g. pk_live_ab12']
  key_hash varchar(255) [not null, unique, note: 'hashed secret — the raw key is shown once at creation and never stored']
  scopes jsonb [note: 'e.g. ["leases.read", "invoices.write"]']
  last_used_at timestamptz
  expires_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    organization_id
    key_hash [unique]
  }
}

Table user_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  organization_id uuid [not null]
  session_token_hash varchar(255) [not null, unique]
  ip_address varchar(45)
  user_agent varchar(500)
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz [note: 'set on explicit logout or "log out all devices"']

  indexes {
    user_id
    session_token_hash [unique]
  }
}

Table login_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [note: 'nullable — may be unresolved if the email does not match any account']
  email varchar(255) [not null]
  user_id uuid [note: 'nullable — set only if the attempt resolved to a known user']
  ip_address varchar(45)
  user_agent varchar(500)
  success boolean [not null]
  failure_reason varchar(100) [note: 'invalid_password, account_locked, unknown_email, mfa_failed, etc']
  attempted_at timestamptz [not null, default: `now()`]

  indexes {
    email
    (email, attempted_at)
    user_id
  }

  Note: 'Powers brute-force / credential-stuffing detection and account-lockout logic. Distinct from activity_logs, which is product analytics rather than an auth security signal.'
}

// =========================================================================
// DOMAIN: PLATFORM OPERATIONS
// =========================================================================

Table feature_flags {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(150) [not null, unique]
  description varchar(500)
  default_enabled boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code [unique]
  }
}

Table organization_feature_flags {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  feature_flag_id uuid [not null]
  is_enabled boolean [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid

  indexes {
    (organization_id, feature_flag_id) [unique]
  }
}

Table background_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [note: 'nullable — some jobs are system-wide, not org-scoped']
  job_type varchar(150) [not null, note: 'e.g. generate_monthly_invoices, send_reminder_email, process_stripe_webhook']
  status job_status [not null, default: 'queued']
  payload jsonb
  attempts int [not null, default: 0]
  max_attempts int [not null, default: 5]
  last_error text
  scheduled_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    status
    (status, scheduled_at)
    organization_id
  }
}

Table webhook_events {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [note: 'nullable — resolved after parsing payload; not all events map to a single org']
  source varchar(50) [not null, note: 'stripe, supabase, etc']
  event_type varchar(150) [not null]
  external_event_id varchar(255) [not null, unique, note: 'idempotency key from the source provider — prevents double-processing on redelivery']
  payload jsonb
  status webhook_status [not null, default: 'pending']
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  error_message text

  indexes {
    external_event_id [unique]
    (source, status)
    organization_id
  }
}

// =========================================================================
// RELATIONSHIPS
// =========================================================================

// Organization Management
Ref: organization_settings.organization_id > organizations.id

// Identity & Access
Ref: users.organization_id > organizations.id
Ref: roles.organization_id > organizations.id
Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.organization_id > organizations.id
Ref: user_invitations.organization_id > organizations.id
Ref: user_invitations.role_id > roles.id
Ref: user_invitations.invited_by > users.id
Ref: password_resets.user_id > users.id

// Property Portfolio
Ref: properties.organization_id > organizations.id
Ref: properties.landlord_user_id > users.id
Ref: property_addresses.organization_id > organizations.id
Ref: property_addresses.property_id > properties.id
Ref: property_images.organization_id > organizations.id
Ref: property_images.property_id > properties.id
Ref: buildings.organization_id > organizations.id
Ref: buildings.property_id > properties.id
Ref: floors.organization_id > organizations.id
Ref: floors.building_id > buildings.id
Ref: units.organization_id > organizations.id
Ref: units.property_id > properties.id
Ref: units.building_id > buildings.id
Ref: units.floor_id > floors.id
Ref: amenities.organization_id > organizations.id
Ref: unit_amenities.organization_id > organizations.id
Ref: unit_amenities.unit_id > units.id
Ref: unit_amenities.amenity_id > amenities.id

// Tenant Management
Ref: tenants.organization_id > organizations.id
Ref: tenants.user_id > users.id
Ref: tenant_emergency_contacts.organization_id > organizations.id
Ref: tenant_emergency_contacts.tenant_id > tenants.id
Ref: tenant_documents.organization_id > organizations.id
Ref: tenant_documents.tenant_id > tenants.id
Ref: tenant_documents.document_id > documents.id
Ref: occupancies.organization_id > organizations.id
Ref: occupancies.unit_id > units.id
Ref: occupancies.tenant_id > tenants.id
Ref: occupancies.lease_id > leases.id

// Lease Management
Ref: leases.organization_id > organizations.id
Ref: leases.unit_id > units.id
Ref: lease_amendments.lease_id > leases.id
Ref: lease_amendments.organization_id > organizations.id
Ref: lease_tenants.organization_id > organizations.id
Ref: lease_tenants.lease_id > leases.id
Ref: lease_tenants.tenant_id > tenants.id
Ref: lease_documents.organization_id > organizations.id
Ref: lease_documents.lease_id > leases.id
Ref: lease_documents.document_id > documents.id
Ref: security_deposits.organization_id > organizations.id
Ref: security_deposits.lease_id - leases.id
Ref: lease_renewals.organization_id > organizations.id
Ref: lease_renewals.original_lease_id > leases.id
Ref: lease_renewals.new_lease_id - leases.id

// Finance
Ref: rent_schedules.organization_id > organizations.id
Ref: rent_schedules.lease_id > leases.id
Ref: invoices.organization_id > organizations.id
Ref: invoices.lease_id > leases.id
Ref: invoice_line_items.organization_id > organizations.id
Ref: invoice_line_items.invoice_id > invoices.id
Ref: payment_methods.organization_id > organizations.id
Ref: payment_methods.tenant_id > tenants.id
Ref: payments.organization_id > organizations.id
Ref: payments.invoice_id > invoices.id
Ref: payments.payment_method_id > payment_methods.id
Ref: transactions.organization_id > organizations.id
Ref: transactions.payment_id > payments.id
Ref: late_fees.organization_id > organizations.id
Ref: late_fees.invoice_id > invoices.id

// Maintenance
Ref: maintenance_categories.organization_id > organizations.id
Ref: maintenance_priorities.organization_id > organizations.id
Ref: maintenance_requests.organization_id > organizations.id
Ref: maintenance_requests.property_id > properties.id
Ref: maintenance_requests.unit_id > units.id
Ref: maintenance_requests.building_id > buildings.id
Ref: maintenance_requests.tenant_id > tenants.id
Ref: maintenance_requests.category_id > maintenance_categories.id
Ref: maintenance_requests.priority_id > maintenance_priorities.id
Ref: maintenance_status_history.organization_id > organizations.id
Ref: maintenance_status_history.maintenance_request_id > maintenance_requests.id
Ref: maintenance_status_history.changed_by > users.id
Ref: maintenance_images.organization_id > organizations.id
Ref: maintenance_images.maintenance_request_id > maintenance_requests.id
Ref: vendors.organization_id > organizations.id
Ref: work_orders.organization_id > organizations.id
Ref: work_orders.maintenance_request_id > maintenance_requests.id
Ref: vendor_assignments.organization_id > organizations.id
Ref: vendor_assignments.work_order_id > work_orders.id
Ref: vendor_assignments.vendor_id > vendors.id

// Documents
Ref: folders.organization_id > organizations.id
Ref: folders.parent_folder_id > folders.id
Ref: documents.organization_id > organizations.id
Ref: documents.folder_id > folders.id
Ref: attachments.organization_id > organizations.id
Ref: attachments.document_id > documents.id

// Communication
Ref: notification_templates.organization_id > organizations.id
Ref: notifications.organization_id > organizations.id
Ref: notifications.user_id > users.id
Ref: notifications.tenant_id > tenants.id
Ref: notifications.template_id > notification_templates.id
Ref: messages.organization_id > organizations.id
Ref: messages.sender_user_id > users.id
Ref: messages.sender_tenant_id > tenants.id
Ref: messages.recipient_user_id > users.id
Ref: messages.recipient_tenant_id > tenants.id
Ref: announcements.organization_id > organizations.id
Ref: announcements.property_id > properties.id

// Administration
Ref: audit_logs.organization_id > organizations.id
Ref: audit_logs.actor_user_id > users.id
Ref: activity_logs.organization_id > organizations.id
Ref: activity_logs.actor_user_id > users.id
Ref: activity_logs.actor_tenant_id > tenants.id

// SaaS Platform & Billing
Ref: organization_subscriptions.organization_id > organizations.id
Ref: organization_subscriptions.plan_id > billing_plans.id
Ref: platform_invoices.organization_id > organizations.id
Ref: platform_invoices.organization_subscription_id > organization_subscriptions.id

// Security & Access
Ref: api_keys.organization_id > organizations.id
Ref: api_keys.created_by > users.id
Ref: user_sessions.user_id > users.id
Ref: user_sessions.organization_id > organizations.id
Ref: login_attempts.organization_id > organizations.id
Ref: login_attempts.user_id > users.id

// Platform Operations
Ref: organization_feature_flags.organization_id > organizations.id
Ref: organization_feature_flags.feature_flag_id > feature_flags.id
Ref: organization_feature_flags.updated_by > users.id
Ref: background_jobs.organization_id > organizations.id
Ref: webhook_events.organization_id > organizations.id

// Late fee <-> billed line item traceability
Ref: late_fees.invoice_line_item_id > invoice_line_items.id

// =========================================================================
// POST-IMPORT SQL MIGRATIONS (not expressible in DBML — apply after import)
// Full statements with rationale live in propertyos_architecture_review_v2.md
// This block is a quick-reference index of what must be run.
// =========================================================================
//
// EXTENSIONS
//   pgcrypto   -- for gen_random_uuid()
//   btree_gist -- for the occupancies exclusion constraint
//
// PARTIAL UNIQUE INDEXES
//   one_active_lease_per_unit           ON leases (unit_id) WHERE status='active'
//   one_active_subscription_per_org     ON organization_subscriptions (organization_id) WHERE status='active'
//
// CHECK CONSTRAINTS
//   chk_lease_dates            leases: start_date < end_date
//   chk_invoice_totals         invoices: total_amount = subtotal + tax_amount
//   chk_invoice_paid_cap       invoices: amount_paid <= total_amount
//   chk_payment_amount         payments: amount > 0
//   chk_deposit_returned_cap   security_deposits: amount_returned <= amount
//   chk_work_order_dates       work_orders: completed_date >= scheduled_date (when both set)
//   chk_message_sender         messages: exactly one of sender_user_id/sender_tenant_id set
//   chk_message_recipient      messages: exactly one of recipient_user_id/recipient_tenant_id set
//   chk_notification_recipient notifications: exactly one of user_id/tenant_id set
//
// EXCLUSION CONSTRAINT
//   excl_unit_occupancy_overlap  occupancies: no two rows for the same unit_id
//                                 with overlapping [move_in_date, move_out_date) ranges
//
// TRIGGERS
//   set_updated_at()             generic trigger, applied to every table with updated_at
//   validate_unit_building_floor  BEFORE INSERT/UPDATE on units — ensures floor_id's
//                                 building_id matches units.building_id when both are set
//
// ROW LEVEL SECURITY
//   Enabled on every organization_id-scoped table; policy pattern:
//     USING (organization_id = current_setting('app.current_org_id')::uuid)
//   Global catalog tables (billing_plans, permissions, feature_flags,
//   system_settings) are read-only to all authenticated roles, write-restricted
//   to a service role — NOT organization-scoped.
//
// See propertyos_architecture_review_v2.md for the complete, runnable SQL.
// =========================================================================
